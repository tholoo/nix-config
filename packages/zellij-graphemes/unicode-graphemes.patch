+#[test]
+fn serializers_preserve_complete_graphemes() {
+    for text in include_str!("../../panes/unit/fixtures/unicode_graphemes.txt").lines() {
+        let mut cells: Vec<TerminalCharacter> = vec![];
+        for character in text.chars() {
+            if let Some(last) = cells.last_mut() {
+                if let Some(extended) = last.extended_with(character) {
+                    *last = extended;
+                    continue;
+                }
+            }
+            cells.push(TerminalCharacter::new(character));
+        }
+        let chunk = CharacterChunk::new(cells, 0, 0);
+        let output = super::super::serialize_chunks(
+            vec![chunk.clone()],
+            None,
+            None,
+            None,
+            true,
+            true,
+            None,
+            None,
+        )
+        .unwrap();
+        assert!(output.contains(text), "positioned serializer: {text:?}");
+        let output =
+            super::super::serialize_chunks_with_newlines(vec![chunk], None, None, true, true, None)
+                .unwrap();
+        assert!(output.contains(text), "newline serializer: {text:?}");
+    }
+}
+
+#[test]
+fn clipping_never_serializes_part_of_an_emoji_grapheme() {
+    let emoji = TerminalCharacter::new('👶').extended_with('🏽').unwrap();
+    let mut chunk = CharacterChunk::new(vec![emoji.clone(), TerminalCharacter::new('x')], 0, 0);
+    let clipped: String = chunk
+        .drain_by_width(1)
+        .flat_map(|cell| cell.characters().collect::<Vec<_>>())
+        .collect();
+    assert_eq!(clipped, " ");
+    let remaining: String = chunk
+        .terminal_characters
+        .iter()
+        .flat_map(|cell| cell.characters())
+        .collect();
+    assert_eq!(remaining, " x");
+    let chunk = CharacterChunk::new(vec![emoji], 0, 0);
+    let output = super::super::serialize_chunks(
+        vec![chunk],
+        None,
+        None,
+        None,
+        true,
+        true,
+        Some(Size { rows: 1, cols: 1 }),
+        None,
+    )
+    .unwrap();
+    assert!(!output.contains('👶'));
+    assert!(!output.contains('🏽'));
+}
