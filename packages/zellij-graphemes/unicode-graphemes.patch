+#[test]
+fn unicode_graphemes_survive_real_pty_input_and_incremental_rendering() {
+    for text in include_str!("fixtures/unicode_graphemes.txt").lines() {
+        for chunk_size in [1, 2, 3, 4, 7, 64] {
+            let mut pane = make_terminal_pane_for_bell();
+            for bytes in text.as_bytes().chunks(chunk_size) {
+                pane.handle_pty_bytes(bytes.to_vec());
+                pane.render(None).unwrap();
+            }
+            assert_eq!(
+                pane.dump_screen(false, None),
+                text,
+                "{text:?}, chunk size {chunk_size}"
+            );
+            // A full repaint must include the same cells as the original stream.
+            pane.grid.force_change_size(20, 121);
+            let (full, _, _) = pane.grid.read_changes(0, 0);
+            let rendered: String = full
+                .iter()
+                .flat_map(|chunk| {
+                    chunk
+                        .terminal_characters
+                        .iter()
+                        .flat_map(|cell| cell.characters())
+                })
+                .collect();
+            assert!(rendered.starts_with(text), "{text:?}: {rendered:?}");
+        }
+    }
+}
