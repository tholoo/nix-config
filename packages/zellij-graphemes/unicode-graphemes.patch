+    /// Try the cell immediately before the cursor before considering line wrapping. A mark
+    /// arriving at the right margin still belongs to that cell, including across PTY reads.
+    fn extend_previous_character(&mut self, character: char) -> bool {
+        let Some(row) = self.viewport.get_mut(self.cursor.y) else {
+            return false;
+        };
+        if self.cursor.x == 0 || self.cursor.x > row.width_cached() {
+            return false;
+        }
+        let (index, offset) = if self.cursor.x == row.width_cached() {
+            let index = row.columns.len() - 1;
+            (index, row.columns[index].width() - 1)
+        } else {
+            row.absolute_character_index_and_position_in_char(self.cursor.x - 1)
+        };
+        let previous = &row.columns[index];
+        if offset + 1 != previous.width() {
+            // The cursor is inside, rather than immediately after, a wide cell.
+            return false;
+        }
+        let Some(extended) = previous.extended_with(character) else {
+            return false;
+        };
+        let old_width = previous.width();
+        let new_width = extended.width();
+        self.preceding_char = Some(extended.clone());
+        let start = self.cursor.x - old_width;
+        if start + new_width > self.width {
+            if self.disable_linewrap || new_width > self.width {
+                // Keep the existing cell when the completed cluster cannot fit.
+                return true;
+            }
+            // A late VS16 can turn the last narrow cell into a wide one. Move the
+            // entire cluster to the next row rather than splitting it at the margin.
+            row.columns.remove(index);
