+/// vte 0.15 can skip valid scalars after completing a partial UTF-8 codepoint:
+/// its partial-buffer error path consumes `valid_up_to()` but only prints the first
+/// scalar. Feed an initial run of continuation bytes separately, so completion
+/// cannot read ahead into another scalar. The remaining input stays batched.
+pub(crate) fn advance_vte_bytes<P: vte::Perform>(
+    parser: &mut vte::Parser,
+    performer: &mut P,
+    bytes: &[u8],
+) -> usize {
+    let prefix_len = bytes
+        .iter()
+        .take(3)
+        .take_while(|b| **b & 0xc0 == 0x80)
+        .count();
+    let mut consumed = 0;
+    for byte in &bytes[..prefix_len] {
+        if parser.advance_until_terminated(performer, std::slice::from_ref(byte)) == 0 {
+            return consumed;
+        }
+        consumed += 1;
+    }
+    consumed + parser.advance_until_terminated(performer, &bytes[consumed..])
+}
