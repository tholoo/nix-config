+            self.add_character_at_cursor_position(extended, false);
+            self.move_cursor_forward_until_edge(new_width);
+        } else {
+            if old_width == new_width {
+                row.columns[index] = extended;
+            } else if self.cursor.x == row.width_cached() {
+                row.columns[index] = extended;
+                row.width = None;
+            } else if self.insert_mode {
+                row.columns.remove(index);
+                row.width = None;
+                row.insert_character_at(extended, start);
