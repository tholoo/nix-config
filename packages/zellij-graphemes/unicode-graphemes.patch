+fn unicode_grapheme_search_uses_scalar_text_and_display_columns() {
+    for text in UNICODE_GRAPHEME_SAMPLES.lines() {
+        let mut grid = create_grid_with_content(text);
+        grid.set_search_string(text);
+        assert_eq!(grid.search_results.selections.len(), 1, "{text:?}");
+        let selection = grid.search_results.selections[0];
+        assert_eq!(selection.start, Position::new(0, 0), "{text:?}");
+        assert_eq!(selection.end.column(), grid.viewport[0].width(), "{text:?}");
+    }
+    let mut grid = create_grid_with_content("👶🏽éz");
+    grid.set_search_string("\u{301}");
+    let selection = grid.search_results.selections[0];
+    assert_eq!(selection.start, Position::new(0, 2));
+    assert_eq!(selection.end, Position::new(0, 3));
+}
+
+#[test]
+fn unicode_grapheme_repeat_repeats_the_complete_cell() {
+    let grid = create_grid_with_content("é\x1b[2b");
+    assert_eq!(rendered_row(&grid, 0), "ééé");
+    assert_eq!(cursor_position(&grid), Some((3, 0)));
+}
+
+#[test]
+fn unicode_grapheme_width_changes_preserve_neighboring_cells() {
+    for (sequence, expected, cursor) in [
+        ("abc\r☁️", "☁️c", 2),
+        ("abc\r\x1b[4h☁️", "☁️abc", 2),
+        ("⚡x\r\x1b[2C\u{fe0e}", "⚡︎ x", 1),
+        ("👶🏽x\r\x1b[1Cz", " zx", 2),
+        ("ábc\rX", "Xbc", 1),
+    ] {
+        let grid = create_grid_with_content(sequence);
+        assert_eq!(rendered_row(&grid, 0), expected, "{sequence:?}");
+        assert_eq!(cursor_position(&grid), Some((cursor, 0)), "{sequence:?}");
+    }
+}
+
+#[test]
+fn unicode_graphemes_keep_base_style_and_do_not_inherit_it_for_following_text() {
+    use crate::panes::terminal_character::{AnsiCode, NamedColor};
+    let grid = create_grid_with_content("\x1b[31me\x1b[32m\u{301}x");
+    assert_eq!(rendered_row(&grid, 0), "éx");
+    assert_eq!(
+        grid.viewport[0].columns[0].styles.foreground,
+        Some(AnsiCode::NamedColor(NamedColor::Red))
+    );
+    assert_eq!(
+        grid.viewport[0].columns[1].styles.foreground,
+        Some(AnsiCode::NamedColor(NamedColor::Green))
+    );
+}
+
+#[test]
+fn unicode_grapheme_copy_on_write_does_not_change_rendered_or_scrollback_clones() {
+    let mut grid = create_grid_with_content("ẋ");
+    let (chunks, _, _) = grid.read_changes(0, 0);
+    let mut parser = vte::Parser::new();
+    parser.advance(&mut grid, "\u{301}".as_bytes());
+    let old: String = chunks[0].terminal_characters[0].characters().collect();
+    assert_eq!(old, "ẋ");
+    assert_eq!(rendered_row(&grid, 0), "ẋ́");
+}
+
+#[test]
+fn unicode_parser_workaround_preserves_ascii_after_partial_utf8() {
+    // vte 0.15 prints the mark but skips 't' here without the continuation-prefix workaround.
+    let mut grid = create_grid_with_content("");
+    let mut parser = vte::Parser::new();
+    for bytes in [b"s\xcc".as_slice(), b"\xb6t\xcc\xb6".as_slice()] {
+        assert_eq!(
+            crate::panes::terminal_pane::advance_vte_bytes(&mut parser, &mut grid, bytes),
+            bytes.len()
+        );
+    }
+    assert_eq!(rendered_row(&grid, 0), "s̶t̶");
+}
+
+#[test]
+fn unicode_parser_workaround_respects_forwarding_termination() {
+    let mut grid = new_grid_for_forwarding_test();
+    let mut parser = vte::Parser::new();
+    let bytes = b"x\x1b]4;1;?\x07tail";
+    let consumed = crate::panes::terminal_pane::advance_vte_bytes(&mut parser, &mut grid, bytes);
+    assert_eq!(&bytes[consumed..], b"tail");
+    assert_eq!(rendered_row(&grid, 0), "x");
+}
+
+#[test]
+fn unicode_grapheme_regex_highlights_cover_whole_cells() {
+    let grid = create_grid_with_content("👶🏽éz");
+    let (_, _, text, boundaries) =
+        super::collect_and_build_logical_line(&grid.viewport, 0).unwrap();
+    for (pattern, start, end) in [("🏽", 0, 2), ("\u{301}", 2, 3), ("z", 3, 4)] {
+        let regex = regex::Regex::new(pattern).unwrap();
+        let matched = regex.find(&text).unwrap();
+        let (selection, _, _, _, _) =
+            super::match_to_selection(&matched, &boundaries, &grid.viewport).unwrap();
+        assert_eq!(selection.start, Position::new(0, start));
+        assert_eq!(selection.end, Position::new(0, end));
+    }
+}
