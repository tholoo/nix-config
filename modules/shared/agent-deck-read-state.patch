+    #[test]
+    fn decks_agree_after_a_legacy_hook_reuses_a_saved_result_generation() {
+        let original = unread_agent("agent", "work", 7);
+        let mut owner = AgentDeck {
+            current_session: "work".into(),
+            model: DeckModel {
+                agents: vec![original.clone()],
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let mut peer = AgentDeck::default();
+        owner.request_focus();
+        owner.acknowledge_clients(vec![ClientInfo::new(
+            1,
+            PaneId::Terminal(7),
+            String::new(),
+            true,
+        )]);
+        let mut saved = original.clone();
+        saved.unread = false;
+        saved.revision += 1;
+        let mut context = AgentDeck::context("auto-read");
+        context.insert("key".into(), original.key.clone());
+        context.insert("attachment_id".into(), original.attachment_id.clone());
+        context.insert("attention_seq".into(), original.attention_seq.to_string());
+        owner.handle_result(
+            Some(0),
+            serde_json::to_vec(&saved).unwrap(),
+            vec![],
+            context.clone(),
+        );
+        owner.apply_agent_signal(original.clone());
+        assert!(!owner.model.agents[0].unread);
+        assert_eq!(owner.model.agents[0].revision, saved.revision);
+
+        // Old hooks preserve fields they don't understand, including the result
+        // generation and revision, when they publish the next completion.
+        saved.unread = true;
+        saved.updated_at += 1;
+        for deck in [&mut owner, &mut peer] {
+            deck.handle_result(
+                Some(0),
+                serde_json::to_vec(&vec![saved.clone()]).unwrap(),
+                vec![],
+                AgentDeck::context("list"),
+            );
+        }
+        assert_eq!(owner.model.agents[0].unread, peer.model.agents[0].unread);
+        assert!(owner.model.agents[0].unread);
+
+        // Visiting the result again must save it again for every deck.
+        owner.acknowledge_clients(vec![ClientInfo::new(
+            1,
+            PaneId::Terminal(7),
+            String::new(),
+            true,
+        )]);
+        assert!(!owner.model.agents[0].unread);
+        saved.unread = false;
+        saved.revision += 1;
+        owner.handle_result(
+            Some(0),
+            serde_json::to_vec(&saved).unwrap(),
+            vec![],
+            context,
+        );
+        peer.apply_agent_signal(saved);
+        assert!(!owner.model.agents[0].unread);
+        assert!(!peer.model.agents[0].unread);
+    }
+
+    #[test]
+    fn read_response_preserves_a_newer_result_the_helper_did_not_acknowledge() {
+        let mut deck = AgentDeck::default();
+        let original = unread_agent("agent", "work", 7);
+        deck.acknowledged
+            .insert(original.key.clone(), (original.attachment_id.clone(), 1));
+        let mut context = AgentDeck::context("auto-read");
+        context.insert("key".into(), original.key.clone());
+        context.insert("attachment_id".into(), original.attachment_id.clone());
+        context.insert("attention_seq".into(), "1".into());
+        let mut newer = original;
+        newer.attention_seq = 2;
+        newer.revision = 3;
+        deck.handle_result(
+            Some(0),
+            serde_json::to_vec(&newer).unwrap(),
+            vec![],
+            context,
+        );
+        assert!(deck.model.agents[0].unread);
+        assert_eq!(deck.model.agents[0].attention_seq, 2);
+        assert!(deck.acknowledged.is_empty());
+    }
+
+    #[test]
+    fn older_read_callback_cannot_clear_a_newer_pending_save() {
+        let mut deck = AgentDeck::default();
+        deck.acknowledged
+            .insert("agent".into(), ("second".into(), 2));
+        let mut context = AgentDeck::context("auto-read");
+        context.insert("key".into(), "agent".into());
+        context.insert("attachment_id".into(), "first".into());
+        context.insert("attention_seq".into(), "1".into());
+        deck.handle_result(Some(1), vec![], b"old failure".to_vec(), context);
+        assert_eq!(deck.acknowledged.get("agent"), Some(&("second".into(), 2)));
+        assert!(deck.notice.is_empty());
+    }
+
+    #[test]
+    fn invalid_read_response_releases_optimistic_state_for_retry() {
+        let mut deck = AgentDeck::default();
+        deck.acknowledged
